# PostgreSQL 17 Local Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse_pipeline
DATABASE_URL=postgres://pulse:pulse_dev_password@localhost:5432/pulse_pipeline?sslmode=disable

# Backend API Server
API_PORT=8080
# Development only (enables `pulse-worker seed-dev`); use production on real hosts.
ENV=development

# Sync worker (ADR-0003)
PULSE_SYNC_POLL_INTERVAL=1m
# Development only: registers the synthetic mock provider. Never enable in production.
PULSE_ENABLE_MOCK_PROVIDER=true

# Google Health API (ADR-0004). Use a "Desktop app" OAuth client; leave both
# empty to run without the Google provider. Real values go in your local .env only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Phase 2 web callback (not used yet; pulse-worker connect-google uses a 127.0.0.1 loopback redirect).
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# OAuth token encryption at rest (AES-256-GCM). Required with the Google provider.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Retired keys still needed to read older rows during a rotation: 1:<base64>,2:<base64>
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Feature Flags (Flipt / OpenFeature)
FLIPT_PORT=8081
FLIPT_URL=http://localhost:8081

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
