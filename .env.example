# PostgreSQL 17 Local Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse_pipeline
DATABASE_URL=postgres://pulse:pulse_dev_password@localhost:5432/pulse_pipeline?sslmode=disable

# Backend API Server
API_PORT=8080
# Development only (enables `pulse-worker seed-dev`, plain-HTTP cookies, and optional dev controls below); use production on real hosts.
ENV=development
# Development / E2E only (ADR-0005 §8): registers POST /api/v1/dev/login when ENV=development. Binds the API to IPv4 loopback when enabled. Leave false in normal use.
PULSE_ENABLE_DEV_LOGIN=false
# Development / E2E only (ADR-0005 §8): pins the API and worker clock to an RFC 3339 instant when ENV=development (leave empty for real time).
PULSE_DEV_NOW=

# Sync worker (ADR-0003)
PULSE_SYNC_POLL_INTERVAL=1m
# Development only: registers the synthetic mock provider. Never enable in production.
PULSE_ENABLE_MOCK_PROVIDER=true

# Google Health API (ADR-0004). Use a "Desktop app" OAuth client; leave both
# empty to run without the Google provider. Real values go in your local .env only.
# pulse-worker connect-google and bind-google-identity use it (127.0.0.1 loopback redirect).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google sign-in for pulse-api (ADR-0005 §2–3). Use a "Web application" OAuth client
# with the redirect URI ${PULSE_PUBLIC_URL}/api/v1/auth/google/callback. Leave the ID
# empty to run the API without sign-in. Real values go in your local .env only.
GOOGLE_WEB_OAUTH_CLIENT_ID=
GOOGLE_WEB_OAUTH_CLIENT_SECRET=
# The origin browsers use: the Vite dev server in development, HTTPS in production.
PULSE_PUBLIC_URL=http://localhost:5173
# Comma-separated addresses allowed to sign in, e.g. you@example.com. Removing an
# address signs that person out when pulse-api restarts; leaving it empty signs out
# everyone who signed in with Google.
PULSE_ALLOWED_EMAILS=

# OAuth token encryption at rest (AES-256-GCM). Required with the Google provider.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Retired keys still needed to read older rows during a rotation: 1:<base64>,2:<base64>
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Feature Flags (Flipt / OpenFeature)
FLIPT_PORT=8081
FLIPT_URL=http://localhost:8081

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
